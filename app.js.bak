const P=window.NEET_PLANNER,days=P.days,DAY_MS=86400000;
const plannerStart=new Date(P.meta.start+'T12:00:00');const now=new Date();const todayDate=new Date(now);todayDate.setHours(12,0,0,0);const autoDay=Math.min(days.length,Math.max(1,Math.floor((todayDate-plannerStart)/DAY_MS)+1));
let selected=Number(localStorage.getItem('neet-day')||autoDay); if(!days.some(d=>d.day===selected))selected=autoDay;let view='today';
const checks=JSON.parse(localStorage.getItem('neet-checks')||'{}'),scores=JSON.parse(localStorage.getItem('neet-scores')||'{}'),mistakes=JSON.parse(localStorage.getItem('neet-mistakes')||'[]'),ncert=JSON.parse(localStorage.getItem('neet-ncert')||'{}'),alarms=JSON.parse(localStorage.getItem('neet-alarms')||'[]'),vault=JSON.parse(localStorage.getItem('neet-vault')||'{"formula":[],"reaction":[]}'),studyLog=JSON.parse(localStorage.getItem('neet-studylog')||'[]');
const $=id=>document.getElementById(id),esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));const day=n=>days.find(x=>x.day===n);const taskId=(d,g,i)=>`${d.day}-${g}-${i}`;
function save(){for(const [k,v] of Object.entries({"neet-checks":checks,"neet-scores":scores,"neet-mistakes":mistakes,"neet-ncert":ncert,"neet-alarms":alarms,"neet-vault":vault,"neet-studylog":studyLog}))localStorage.setItem(k,JSON.stringify(v));localStorage.setItem('neet-day',selected);$('savedStatus').textContent='Saved just now';setTimeout(()=>{$('savedStatus').textContent='Saved locally'},900)}
function checkbox(d,g,i,text){let id=taskId(d,g,i);return `<li><input class="taskbox" type="checkbox" data-id="${id}" ${checks[id]?'checked':''}><span>${esc(text)}</span></li>`}
function targetFor(d){if(d.mock)return{acc:90,completion:100};if(d.day<=90)return{acc:80,completion:95};if(d.day<=160)return{acc:85,completion:95};if(d.day<=205)return{acc:88,completion:97};return{acc:90,completion:100}}
function dailyFeedback(s,t){if(!s.acc&&!s.backlog)return'Log your result after the final question set. The dashboard will create repair priorities.';let a=+s.acc||0,b=+s.backlog||0,c=+s.careless||0;if(a>=t.acc&&b===0&&c<=2)return'🟢 GREEN — standard met. Review every error anyway.';if(a>=t.acc-5&&b<=3)return'🟡 AMBER — repair the weakest area tonight and retest within 48 hours.';return'🔴 RED — repair first: wrong answers → rule/NCERT/formula → closed-book redo → retest.'}
function scoreCard(d){let s=scores[d.day]||{};if(d.mock)return `<div class="rank-card"><b>FULL MOCK SCORECARD</b><div class="scoregrid"><label>Score / 720<input id="mockScore" type="number" min="0" max="720" value="${s.score||''}"></label><label>Accuracy %<input id="mockAcc" type="number" min="0" max="100" value="${s.acc||''}"></label><label>Careless errors<input id="careless" type="number" min="0" value="${s.careless||''}"></label><label>Unfinished<input id="backlog" type="number" min="0" value="${s.backlog||''}"></label><label>Biology / 360<input id="bioScore" type="number" min="0" max="360" value="${s.bio||''}"></label><label>Physics / 180<input id="phyScore" type="number" min="0" max="180" value="${s.phy||''}"></label><label>Chemistry / 180<input id="chemScore" type="number" min="0" max="180" value="${s.chem||''}"></label><label>Time used (min)<input id="mockTime" type="number" min="0" value="${s.time||''}"></label></div><button id="saveScore" class="primary">Save mock</button><div id="scoreFeedback" class="notice">${s.acc?mockFeedback(s):'Log the mock and the system will classify it.'}</div></div>`;
let t=targetFor(d);return `<div class="rank-card"><b>DAILY PERFORMANCE SCORECARD</b><div class="scoregrid"><label>Overall accuracy %<input id="dayAcc" type="number" min="0" max="100" value="${s.acc||''}"></label><label>Careless errors<input id="dayCareless" type="number" min="0" value="${s.careless||''}"></label><label>Backlog items<input id="dayBacklog" type="number" min="0" value="${s.backlog||''}"></label><label>Confidence / 5<input id="confidence" type="number" min="1" max="5" value="${s.confidence||''}"></label></div><div class="small targetline">Floor: <b>${t.acc}% accuracy</b> • <b>${t.completion}% execution</b> • careless errors trending to 0</div><button id="saveScore" class="primary">Save daily result</button><div id="scoreFeedback" class="notice">${dailyFeedback(s,t)}</div></div>`}
function mockFeedback(s){let a=+s.acc||0,c=+s.careless||0,b=+s.backlog||0;return a>=90&&c<=3&&b===0?'🟢 GREEN — strong exam control.':a>=85?'🟡 AMBER — convert avoidable errors into rules and retest within 72h.':'🔴 RED — stop adding random workload; repair the lowest-performing subject/topic first.'}
function bindScore(d){const b=$('saveScore');if(!b)return;b.onclick=()=>{scores[d.day]=d.mock?{score:$('mockScore').value,acc:$('mockAcc').value,careless:$('careless').value,backlog:$('backlog').value,bio:$('bioScore').value,phy:$('phyScore').value,chem:$('chemScore').value,time:$('mockTime').value}:{acc:$('dayAcc').value,careless:$('dayCareless').value,backlog:$('dayBacklog').value,confidence:$('confidence').value};save();$('scoreFeedback').textContent=d.mock?mockFeedback(scores[d.day]):dailyFeedback(scores[d.day],targetFor(d));renderAdaptivePanel()}}
function renderAdaptivePanel(){let weak=Object.entries(scores).map(([k,v])=>({day:+k,...v})).filter(x=>x.acc).sort((a,b)=>(+a.acc)-(+b.acc)).slice(0,5);let el=$('adaptivePanel');if(!el)return;el.innerHTML=weak.length?`<b>Repair priorities</b><ul>${weak.map(x=>`<li>Day ${x.day}: ${x.acc}% accuracy${x.careless?` • ${x.careless} careless`:''} — redo wrong answers closed-book, write the rule, retest.</li>`).join('')}</ul>`:'<b>Repair queue</b><p class="small">Log accuracy to activate weak-performance triage.</p>'}
function renderToday(){const d=day(selected);$('pageTitle').textContent=`Day ${d.day}: ${d.title}`;$('pageSub').textContent=`${new Date(d.date+'T12:00:00').toLocaleDateString(undefined,{weekday:'long',day:'numeric',month:'long',year:'numeric'})} • planned exam date ${P.meta.exam}`;let pct=Math.round(d.day/P.meta.days*100),cards='';if(d.mock)cards=`<div class="card"><div class="eyebrow">MOCK DAY</div><h2>180-question simulation</h2><p class="small">${esc(d.mission)}</p><div class="chips"><span class="chip">8:00–11:20 AM</span><span class="chip">Exam conditions</span><span class="chip">3-pass analysis</span></div></div>`;else for(const[s,o]of Object.entries(d.subjects)){let cls=s==='Biology'?'bio':s==='Physics'?'phy':'chem';cards+=`<article class="card subject ${cls}"><div class="small">${s.toUpperCase()} • ${esc(o.mode)}${o.cycle>1?' • Revision '+o.cycle:''}</div><h3>${esc(o.topic)}</h3><div class="small">${o.questionTarget} questions • ${o.pyqTarget} PYQs</div><h4>Subtopics</h4><ul class="checklist">${o.subtopics.map((x,i)=>checkbox(d,s+'-sub',i,x)).join('')}</ul><h4>Practice</h4><ul class="checklist">${o.practice.map((x,i)=>checkbox(d,s+'-prac',i,x)).join('')}</ul></article>`}
let sections=`<div class="hero"><div><div class="eyebrow" style="color:#d8a31a">DAY ${d.day} / ${P.meta.days}</div><h2>${esc(d.mission)}</h2><p>PLAN → STUDY → TEST → ANALYZE → REPAIR → RETEST</p></div><div class="progress"><div class="label"><span>Timeline</span><b>${pct}%</b></div><div class="progress-bar"><div class="progress-fill" style="width:${pct}%"></div></div></div></div><div class="quick-actions"><button onclick="startFocus()">⏱ Start Focus</button><button onclick="quickMistake()">❌ Log Mistake</button><button onclick="requestNotifications()">🔔 Enable Alerts</button></div><div class="cards">${cards}</div>${scoreCard(d)}<div class="section-title"><h2>Exact Daily Execution</h2><span class="small">Unfinished work enters repair</span></div><div class="card"><ul class="checklist">${d.tasks.map((x,i)=>checkbox(d,'daily',i,x)).join('')}</ul></div>`;
if(!d.mock)sections+=`<div class="section-title"><h2>2-3-5-7 Scheduled Revisions</h2></div><div class="cards">${d.revisions.length?d.revisions.map((r,ri)=>`<div class="card revision"><b>${esc(r.label)}</b><div class="small">Source Day ${r.sourceDay} • ${r.when}</div><ul class="checklist">${Object.entries(r.topics).map(([s,t],i)=>checkbox(d,'rev'+ri+s,i,`${s}: ${t}`)).join('')}</ul></div>`).join(''):'<div class="notice">No prior-topic revision due yet. Use active recall tonight.</div>'}</div>`;
sections+=`<div class="section-title"><h2>Micro-Schedule</h2></div><div class="schedule"><table><thead><tr><th>Time</th><th>Activity</th></tr></thead><tbody>${d.schedule.map(r=>`<tr><td><b>${esc(r[0])}</b></td><td>${esc(r[1])}</td></tr>`).join('')}</tbody></table></div><div class="section-title"><h2>Adaptive Repair Queue</h2></div><div id="adaptivePanel" class="card"></div><div class="section-title"><h2>Today at a glance</h2></div>${todayMetrics()}`;$('appContent').innerHTML=sections;bindChecks();bindScore(d);renderAdaptivePanel()}
function todayMetrics(){let d=day(selected),total=0,done=0;d.tasks.forEach((_,i)=>{total++;if(checks[taskId(d,'daily',i)])done++});return `<div class="stats"><div class="card stat"><span class="small">TASKS</span><b>${done}/${total}</b></div><div class="card stat"><span class="small">EXECUTION</span><b>${total?Math.round(done/total*100):0}%</b></div><div class="card stat"><span class="small">ERRORS LOGGED</span><b>${mistakes.filter(x=>x.day===selected).length}</b></div><div class="card stat"><span class="small">ALARMS</span><b>${alarms.filter(x=>x.enabled!==false).length}</b></div></div>`}
function bindChecks(){document.querySelectorAll('.taskbox').forEach(x=>x.addEventListener('change',()=>{checks[x.dataset.id]=x.checked;save()}))}
function renderCalendar(){$('pageTitle').textContent='236-Day Calendar';$('pageSub').textContent='Tap a day to execute it. Every Sunday is a full mock.';$('appContent').innerHTML=`<div class="notice"><b>Day 1 = 15 September 2026.</b> Every Sunday is a full mock; study/recovery work is replanned around it. The 236-day horizon ends 8 May 2027.</div><div style="height:14px"></div><div class="daygrid">${days.map(d=>`<div class="daycell ${d.mock?'mock':''} ${d.day===selected?'today':''}" data-day="${d.day}"><div class="n">Day ${d.day}</div><div class="d">${new Date(d.date+'T12:00:00').toLocaleDateString(undefined,{day:'2-digit',month:'short'})}</div><div class="t">${esc(d.mock?'FULL MOCK':Object.values(d.subjects).map(x=>x.topic).join(' • '))}</div></div>`).join('')}</div>`;document.querySelectorAll('.daycell').forEach(c=>c.onclick=()=>{selected=+c.dataset.day;view='today';render();save()})}
function renderProgress(){let checked=Object.values(checks).filter(Boolean).length,scored=Object.values(scores).filter(x=>x.acc).map(x=>+x.acc),avg=scored.length?Math.round(scored.reduce((a,b)=>a+b,0)/scored.length):0,best=scored.length?Math.max(...scored):0,mockCount=Object.values(scores).filter(x=>x.score).length;let errs=mistakes.length,careless=Object.values(scores).reduce((n,x)=>n+(+x.careless||0),0);$('pageTitle').textContent='Progress & Analytics';$('pageSub').textContent='Measure execution, accuracy, errors and exam control.';$('appContent').innerHTML=`<div class="stats"><div class="card stat"><span class="small">CHECKED ITEMS</span><b>${checked}</b></div><div class="card stat"><span class="small">AVG ACCURACY</span><b>${avg||'—'}%</b></div><div class="card stat"><span class="small">BEST ACCURACY</span><b>${best||'—'}%</b></div><div class="card stat"><span class="small">MOCKS</span><b>${mockCount}</b></div><div class="card stat"><span class="small">ERROR BANK</span><b>${errs}</b></div><div class="card stat"><span class="small">CARELESS ERRORS</span><b>${careless}</b></div></div><div class="section-title"><h2>Mock score trend</h2></div><div class="card chart">${mockChart()}</div><div class="section-title"><h2>Subject completion</h2></div>${subjectCompletion()}<div class="section-title"><h2>Readiness gates</h2></div><div class="card gates"><p>🟢 Foundation: NCERT + concepts + daily execution.</p><p>🟡 Accuracy: mature topics ≥90% and careless errors falling.</p><p>🟠 Exam control: full mocks under strict timing + 3-pass analysis.</p><p>🔴 Repair: repeated errors become written rules + retests.</p></div>`}
function mockChart(){let a=Object.entries(scores).filter(([,x])=>x.score).sort((a,b)=>+a[0]-+b[0]);if(!a.length)return'<div class="empty">No mock scores yet.</div>';let max=720;return `<div class="bars">${a.map(([d,x])=>`<div class="vbar"><div class="barfill" style="height:${Math.max(5,+x.score/max*100)}%"><span>${x.score}</span></div><small>D${d}</small></div>`).join('')}</div>`}
function subjectCompletion(){let out='';for(const s of ['Biology','Physics','Chemistry']){let a=0,b=0;days.forEach(d=>{if(!d.mock&&d.subjects[s])d.subjects[s].subtopics.forEach((_,i)=>{a++;if(checks[`${d.day}-${s}-sub-${i}`])b++})});out+=`<div class="card barrow"><div class="label"><b>${s}</b><span>${b}/${a} • ${a?Math.round(b/a*100):0}%</span></div><div class="bar"><div class="fill" style="width:${a?b/a*100:0}%"></div></div></div>`}return out}
function renderMistakes(){$('pageTitle').textContent='❌ Error Bank';$('pageSub').textContent='Every mistake becomes a repair asset.';$('appContent').innerHTML=`<div class="card"><div class="formgrid"><label>Date/day<input id="mDay" type="number" min="1" max="236" value="${selected}"></label><label>Subject<select id="mSubject"><option>Biology</option><option>Physics</option><option>Chemistry</option></select></label><label>Topic<input id="mTopic" placeholder="e.g. Laws of Motion"></label><label>Type<select id="mType"><option>Conceptual</option><option>NCERT fact</option><option>Formula</option><option>Calculation</option><option>Misread</option><option>Careless</option><option>Guessing</option><option>Time pressure</option></select></label></div><label>Question / mistake<textarea id="mText" placeholder="What went wrong?"></textarea><label>Correct rule / takeaway<textarea id="mRule" placeholder="Write the one rule you must remember"></textarea><button id="addMistake" class="primary">Add to Error Bank</button></div><div class="section-title"><h2>Repair queue (${mistakes.length})</h2><button class="ghost dark" onclick="clearResolved()">Clear resolved</button></div><div class="error-list">${mistakes.length?mistakes.slice().reverse().map((m,i)=>`<div class="card error ${m.resolved?'resolved':''}"><div class="label"><b>D${m.day} • ${esc(m.subject)} • ${esc(m.topic||'Untitled')}</b><span>${esc(m.type)}</span></div><p>${esc(m.text)}</p><div class="notice">Rule: ${esc(m.rule||'—')}</div><div class="toolbar"><button onclick="resolveMistake(${mistakes.length-1-i})">${m.resolved?'↩ Reopen':'✓ Mark repaired'}</button><button onclick="deleteMistake(${mistakes.length-1-i})">Delete</button></div></div>`).join(''):'<div class="empty">No errors logged. Add mistakes after practice.</div>'}</div>`;$('addMistake').onclick=()=>{mistakes.push({day:+$('mDay').value,subject:$('mSubject').value,topic:$('mTopic').value,type:$('mType').value,text:$('mText').value,rule:$('mRule').value,resolved:false,created:new Date().toISOString()});save();renderMistakes()}}
function resolveMistake(i){mistakes[i].resolved=!mistakes[i].resolved;save();renderMistakes()}function deleteMistake(i){mistakes.splice(i,1);save();renderMistakes()}function clearResolved(){for(let i=mistakes.length-1;i>=0;i--)if(mistakes[i].resolved)mistakes.splice(i,1);save();renderMistakes()}
function renderNcert(){const chapters=[...new Set(days.flatMap(d=>d.subjects?Object.values(d.subjects).filter(x=>x&&x.topic).filter(x=>/biology/i.test(JSON.stringify(d.subjects))?false:false):[]))];const fallback=['The Living World','Biological Classification','Plant Kingdom','Animal Kingdom','Morphology of Flowering Plants','Anatomy of Flowering Plants','Structural Organisation in Animals','Cell: The Unit of Life','Biomolecules','Cell Cycle and Division','Transport in Plants','Mineral Nutrition','Photosynthesis','Respiration in Plants','Plant Growth and Development','Digestion and Absorption','Breathing and Exchange of Gases','Body Fluids and Circulation','Excretory Products and Elimination','Locomotion and Movement','Neural Control and Coordination','Chemical Coordination and Integration','Reproduction','Genetics','Molecular Basis of Inheritance','Evolution','Human Health and Disease','Biotechnology','Ecology','Biodiversity'];$('pageTitle').textContent='📚 NCERT Tracker';$('pageSub').textContent='Track reading, recall, diagrams and question conversion.';$('appContent').innerHTML=`<div class="notice">For Biology, use this as an NCERT-first checklist. Update chapter names if the official syllabus changes.</div><div class="section-title"><h2>NCERT coverage</h2><span>${Object.values(ncert).filter(Boolean).length}/${fallback.length} complete</span></div><div class="ncert-grid">${fallback.map((c,i)=>`<label class="ncert card"><input type="checkbox" data-ncert="${i}" ${ncert[i]?.read?'checked':''}><b>${esc(c)}</b><span>${ncert[i]?.recall?'✓ Recall':''}${ncert[i]?.diagram?' • Diagram':''}${ncert[i]?.mcq?' • MCQ':''}</span><div><button onclick="toggleNcert(${i},'recall')">Recall</button><button onclick="toggleNcert(${i},'diagram')">Diagram</button><button onclick="toggleNcert(${i},'mcq')">MCQ</button></div></label>`).join('')}</div>`;document.querySelectorAll('[data-ncert]').forEach(x=>x.onchange=()=>{ncert[x.dataset.ncert]={...(ncert[x.dataset.ncert]||{}),read:x.checked};save();renderNcert()})}
function toggleNcert(i,k){ncert[i]={...(ncert[i]||{}),[k]:!ncert[i]?.[k]};save();renderNcert()}
function renderVaults(){$('pageTitle').textContent='⚡ Formula & Reaction Vault';$('pageSub').textContent='Build your personal recall deck, not a passive notes dump.';$('appContent').innerHTML=`${vaultBox('formula','⚡ Physics Formula Vault','Formula • meaning • units • common trap')}${vaultBox('reaction','🧪 Chemistry Reaction Vault','Reaction • reagent • condition • exception')}`}
function vaultBox(type,title,hint){let arr=vault[type]||[];return `<div class="section-title"><h2>${title}</h2><span class="small">${hint}</span></div><div class="card"><div class="formgrid"><input id="vTopic-${type}" placeholder="Chapter / topic"><input id="vFront-${type}" placeholder="Formula / reaction"><input id="vBack-${type}" placeholder="Meaning, condition, exception, trap"><button class="primary" onclick="addVault('${type}')">Add</button></div><div class="vault-list">${arr.map((v,i)=>`<div class="vault-item"><b>${esc(v.topic)}</b><div>${esc(v.front)}</div><small>${esc(v.back)}</small><button onclick="deleteVault('${type}',${i})">Delete</button></div>`).join('')}</div></div>`}
function addVault(type){let topic=$(`vTopic-${type}`).value,front=$(`vFront-${type}`).value,back=$(`vBack-${type}`).value;if(!front)return;vault[type].push({topic,front,back});save();renderVaults()}function deleteVault(t,i){vault[t].splice(i,1);save();renderVaults()}
let timer={running:false,end:0,seconds:0,interval:null};function renderTimer(){$('pageTitle').textContent='⏱ Focus Timer';$('pageSub').textContent='50 min focus • 10 min break • log real study time.';$('appContent').innerHTML=`<div class="timer card"><div id="timerDisplay">50:00</div><div class="timer-presets"><button onclick="setTimer(25)">25 min</button><button onclick="setTimer(50)">50 min</button><button onclick="setTimer(90)">90 min</button><button onclick="setTimer(10)">10 min break</button></div><div class="toolbar"><button class="primary" onclick="toggleTimer()">Start / Pause</button><button onclick="resetTimer()">Reset</button></div><p class="small">When the timer ends, a browser notification + audio alarm fires if permitted.</p></div><div class="section-title"><h2>Study log</h2></div><div class="card">${studyLog.slice().reverse().slice(0,30).map(x=>`<p>Day ${x.day} • ${x.minutes} min • ${new Date(x.at).toLocaleString()}</p>`).join('')||'<div class="empty">No sessions yet.</div>'}</div>`;updateTimerDisplay()}
function setTimer(min){timer.seconds=min*60;timer.running=false;clearInterval(timer.interval);updateTimerDisplay()}function updateTimerDisplay(){let el=$('timerDisplay');if(el){let s=timer.running?Math.max(0,Math.ceil((timer.end-Date.now())/1000)):timer.seconds;el.textContent=`${String(Math.floor(s/60)).padStart(2,'0')}:${String(s%60).padStart(2,'0')}`}}function toggleTimer(){if(timer.running){timer.seconds=Math.max(0,Math.ceil((timer.end-Date.now())/1000));timer.running=false;clearInterval(timer.interval);updateTimerDisplay();return}if(!timer.seconds)timer.seconds=3000;timer.end=Date.now()+timer.seconds*1000;timer.running=true;timer.interval=setInterval(()=>{updateTimerDisplay();if(Date.now()>=timer.end){timer.running=false;clearInterval(timer.interval);studyLog.push({day:selected,minutes:Math.round(timer.seconds/60),at:new Date().toISOString()});save();fireAlarm('Focus session complete','Time is up. Log your work and take a 10-minute break.');renderTimer()}},250)}function resetTimer(){timer.running=false;clearInterval(timer.interval);timer.seconds=3000;updateTimerDisplay()}function startFocus(){view='timer';render()}
function requestNotifications(){if(!('Notification'in window)){alert('This browser does not support notifications.');return}Notification.requestPermission().then(p=>{if(p==='granted'){notify('NEET 2027 alerts enabled','Your study reminders can now notify you.');scheduleAlarms()}})}function notify(title,body){if('Notification'in window&&Notification.permission==='granted')new Notification(title,{body,icon:'',tag:'neet27'})}function fireAlarm(title,body){notify(title,body);try{const C=window.AudioContext||window.webkitAudioContext;if(C){const c=new C(),o=c.createOscillator(),g=c.createGain();o.connect(g);g.connect(c.destination);o.frequency.value=880;g.gain.value=.12;o.start();setTimeout(()=>{o.stop();c.close()},1200)}}catch(e){}}
function renderAlarms(){$('pageTitle').textContent='🔔 Alarms & Alerts';$('pageSub').textContent='Browser notifications and audio alarms. Sunday mock reminders can be scheduled separately. Keep the app open for reliable scheduled alarms.';$('appContent').innerHTML=`<div class="notice"><b>Important:</b> browser notifications are permission-based. Scheduled alarms created by this page are reliable while the site/app is open; a normal website cannot guarantee an alarm after the browser/OS fully suspends it.</div><div class="quick-actions"><button class="primary" onclick="requestNotifications()">🔔 Allow Notifications</button><button onclick="addSundayMockAlarm()">⏰ Add Sunday Mock Alarm</button><button onclick="testAlarm()">🔊 Test Alarm</button></div><div class="card"><div class="formgrid"><label>Time<input id="aTime" type="time" value="06:30"></label><label>Label<input id="aLabel" value="Start NEET mission"></label><label>Days<select id="aDays"><option value="daily">Every day</option><option value="weekday">Mon–Fri</option><option value="weekend">Sat–Sun</option><option value="sunday">Sunday only</option></select></label><button class="primary" onclick="addAlarm()">Add Alarm</button></div></div><div class="alarm-list">${alarms.map((a,i)=>`<div class="card alarm"><b>${esc(a.time)} — ${esc(a.label)}</b><span class="small">${a.days} • ${a.enabled===false?'OFF':'ON'}</span><div><button onclick="toggleAlarm(${i})">${a.enabled===false?'Enable':'Disable'}</button><button onclick="deleteAlarm(${i})">Delete</button></div></div>`).join('')||'<div class="empty">No alarms yet.</div>'}</div>`;scheduleAlarms()}
function addAlarm(){alarms.push({time:$('aTime').value,label:$('aLabel').value,days:$('aDays').value,enabled:true});save();renderAlarms()}function addSundayMockAlarm(){if(!alarms.some(a=>a.time==='07:30'&&a.days==='sunday'&&a.label==='Sunday Full Mock'))alarms.push({time:'07:30',label:'Sunday Full Mock',days:'sunday',enabled:true});save();renderAlarms();requestNotifications()}function toggleAlarm(i){alarms[i].enabled=alarms[i].enabled===false;save();renderAlarms()}function deleteAlarm(i){alarms.splice(i,1);save();renderAlarms()}function testAlarm(){fireAlarm('NEET 2027 test alarm','Notification and audio are working.')}function scheduleAlarms(){if(window._alarmInterval)clearInterval(window._alarmInterval);window._alarmInterval=setInterval(()=>{let n=new Date(),hm=n.toTimeString().slice(0,5),wd=n.getDay(),key=`${n.toDateString()}-${hm}`;alarms.forEach(a=>{if(a.enabled===false||a.time!==hm||localStorage.getItem('alarm-fired-'+key+'-'+a.label))return;let ok=a.days==='daily'||(a.days==='weekday'&&wd>=1&&wd<=5)||(a.days==='weekend'&&(wd===0||wd===6))||(a.days==='sunday'&&wd===0);if(ok){localStorage.setItem('alarm-fired-'+key+'-'+a.label,'1');fireAlarm('NEET 2027 • '+a.label,`Day ${selected} — execute your scheduled mission.`)}})},1000)}
function renderBackup(){$('pageTitle').textContent='💾 Backup / Restore';$('pageSub').textContent='Protect your months of progress.';$('appContent').innerHTML=`<div class="card"><h2>Export</h2><p class="small">Downloads all checks, scorecards, errors, NCERT progress, vaults, alarms and study logs.</p><button class="primary" onclick="exportData()">Download Backup JSON</button></div><div class="card"><h2>Import</h2><input id="importFile" type="file" accept="application/json"><p class="small">Importing replaces current local progress.</p></div>`;$('importFile').onchange=e=>importData(e.target.files[0])}
function exportData(){let data={version:2,exportedAt:new Date().toISOString(),checks,scores,mistakes,ncert,alarms,vault,studyLog};let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(data,null,2)],{type:'application/json'}));a.download=`neet2027-backup-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href)}function importData(file){if(!file)return;let r=new FileReader();r.onload=()=>{try{let x=JSON.parse(r.result);Object.assign(checks,x.checks||{});Object.assign(scores,x.scores||{});mistakes.splice(0,mistakes.length,...(x.mistakes||[]));Object.keys(ncert).forEach(k=>delete ncert[k]);Object.assign(ncert,x.ncert||{});alarms.splice(0,alarms.length,...(x.alarms||[]));vault.formula=x.vault?.formula||[];vault.reaction=x.vault?.reaction||[];studyLog.splice(0,studyLog.length,...(x.studyLog||[]));save();alert('Backup restored.');renderBackup()}catch(e){alert('Invalid backup file.')}};r.readAsText(file)}
function renderRevisions(){let rows=[];days.filter(d=>!d.mock).forEach(d=>d.revisions.forEach(r=>rows.push({day:d.day,label:r.label,source:r.sourceDay,topics:Object.entries(r.topics).map(([s,t])=>`${s}: ${t}`).join(' • ')})));rows=rows.slice(0,180);$('pageTitle').textContent='2-3-5-7 Revision Queue';$('pageSub').textContent='Retrieval before rereading.';$('appContent').innerHTML=`<div class="notice">Close notes → recall → answer → correct → record the error → retest.</div><div class="card"><table><thead><tr><th>Due Day</th><th>Pass</th><th>Source</th><th>Topics</th></tr></thead><tbody>${rows.map(r=>`<tr><td>D${r.day}</td><td>${esc(r.label)}</td><td>D${r.source}</td><td>${esc(r.topics)}</td></tr>`).join('')}</tbody></table></div>`}
function renderSettings(){$('pageTitle').textContent='Settings';$('pageSub').textContent='Local-only • Day 1 starts 15 Sep 2026.';$('appContent').innerHTML=`<div class="card"><h2>Mission contract</h2><ul><li>Execute the generated day instead of choosing random chapters.</li><li>Every mistake gets logged, repaired and retested.</li><li>Use accuracy + completion + mock trend, not hours alone.</li><li>Planner date is a planned date and should follow official NTA announcements if they differ.</li></ul><div class="toolbar"><button onclick="window.print()">Print current view</button><button onclick="location.reload()">Reload app</button></div></div><div class="card"><h2>Planner configuration</h2><p>Day 1: <b>${P.meta.start}</b><br>Final planned day: <b>${P.meta.exam}</b><br>Total days: <b>${P.meta.days}</b></p><p class="small">Notifications require browser permission. For phone alarms, install the PWA and allow notifications/alarms in the OS where supported.</p></div>`}
function setActive(){document.querySelectorAll('.nav').forEach(b=>b.classList.toggle('active',b.dataset.view===view))}function render(){setActive();if(view==='today')renderToday();else if(view==='calendar')renderCalendar();else if(view==='progress')renderProgress();else if(view==='mistakes')renderMistakes();else if(view==='ncert')renderNcert();else if(view==='vaults')renderVaults();else if(view==='revisions')renderRevisions();else if(view==='timer')renderTimer();else if(view==='alarms')renderAlarms();else if(view==='backup')renderBackup();else renderSettings();}
$('daySelect').innerHTML=days.map(d=>`<option value="${d.day}">Day ${d.day} — ${d.date}${d.mock?' • MOCK':''}</option>`).join('');$('daySelect').value=selected;$('daySelect').onchange=e=>{selected=+e.target.value;view='today';render();save()};$('prevBtn').onclick=()=>{selected=Math.max(1,selected-1);$('daySelect').value=selected;render();save()};$('nextBtn').onclick=()=>{selected=Math.min(days.length,selected+1);$('daySelect').value=selected;render();save()};$('printBtn').onclick=()=>window.print();$('notifyBtn').onclick=requestNotifications;document.querySelectorAll('.nav').forEach(b=>b.onclick=()=>{view=b.dataset.view;render()});$('resetBtn').onclick=()=>{if(confirm('Reset all checkboxes and scorecards?')){localStorage.removeItem('neet-checks');localStorage.removeItem('neet-scores');location.reload()}};$('search').oninput=e=>{let q=e.target.value.trim().toLowerCase();if(!q)return;let hit=days.find(d=>JSON.stringify(d).toLowerCase().includes(q));if(hit){selected=hit.day;$('daySelect').value=selected;view='today';render()}};
if('serviceWorker'in navigator)navigator.serviceWorker.register('./sw.js').catch(()=>{});scheduleAlarms();render();
window.requestNotifications=requestNotifications;window.startFocus=startFocus;window.quickMistake=()=>{view='mistakes';render()};window.resolveMistake=resolveMistake;window.deleteMistake=deleteMistake;window.clearResolved=clearResolved;window.toggleNcert=toggleNcert;window.addVault=addVault;window.deleteVault=deleteVault;window.setTimer=setTimer;window.toggleTimer=toggleTimer;window.resetTimer=resetTimer;window.fireAlarm=fireAlarm;window.testAlarm=testAlarm;window.addAlarm=addAlarm;window.toggleAlarm=toggleAlarm;window.deleteAlarm=deleteAlarm;window.exportData=exportData;window.importData=importData;
